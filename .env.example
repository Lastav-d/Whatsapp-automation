# ==========================================
# Server
# ==========================================
PORT=3000

# ==========================================
# Meta / WhatsApp Cloud API
# ==========================================
# Webhook verify token — you set this yourself, and enter the SAME value
# in Meta App Dashboard > WhatsApp > Configuration > Webhook > Verify Token
WHATSAPP_VERIFY_TOKEN=choose_any_random_string_here

# App Secret from Meta App Dashboard > Settings > Basic
# Used to validate the X-Hub-Signature-256 header on every webhook POST
WHATSAPP_APP_SECRET=your_meta_app_secret

# Permanent System User access token (Meta Business Suite > System Users)
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token

# Phone Number ID used to SEND messages (Meta App Dashboard > WhatsApp > API Setup)
# NOTE: the original n8n workflow used two DIFFERENT phone number IDs across
# nodes (1030974210092739 in "HTTP Request" vs 1240163099173755 in
# "Send message1-summary"). That was almost certainly a bug/inconsistency.
# This app uses ONE phone number ID everywhere — set the correct one below.
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Graph API version
WHATSAPP_GRAPH_API_VERSION=v20.0

# Optional: WhatsApp Flow ID for native in-app DatePicker calendar
# Create in Meta Business Suite > WhatsApp Manager > Flows
WHATSAPP_FLOW_ID=your_flow_id_here



# ==========================================
# Supabase
# ==========================================
# Supabase Project URL (e.g. https://your-project-id.supabase.co)
SUPABASE_URL=https://njmzdeddmangggeukjce.supabase.co/rest/v1/

